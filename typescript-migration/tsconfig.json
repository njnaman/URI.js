{
  "compilerOptions": {
    "target": "es5",
    "module": "umd",
    "lib": ["ES5", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "noImplicitThis": false,
    "noImplicitAny": false,
    "declaration": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
