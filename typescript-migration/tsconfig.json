{
  "compilerOptions": {
    "target": "es5",
    "module": "es6",
    "lib": ["es6", "DOM"],
    "outDir": "./dist",
    "allowUmdGlobalAccess": true,
    "strict": true,
    "declaration": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
  ],
  "exclude": [
//    "src/URI.ts",
    "node_modules",
    "dist",
  ]
}
