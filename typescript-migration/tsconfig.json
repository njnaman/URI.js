{
  "compilerOptions": {
    "target": "es5",
    "module": "umd",
    "lib": ["ES5", "DOM"],
    "outDir": "./dist",
    "strict": false,
    "noImplicitThis": false,
    "noImplicitAny": false,
    "declaration": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
