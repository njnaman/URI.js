{
  "compilerOptions": {
    "target": "es2018",
    "module": "commonjs",
    "lib": ["ES2018", "DOM"],
    "outDir": "./dist",
    "strict": false,
    "noImplicitThis": false,
    "noImplicitAny": false,
    "declaration": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "test-runner.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/index.ts"
  ]
}
