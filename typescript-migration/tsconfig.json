{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "lib": ["es2020", "DOM"],
    "outDir": "./dist",
    "allowUmdGlobalAccess": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "declaration": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./types"]
  },
  "ts-node": {
    "esm": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "types/**/*",
    "test-runner.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
